# Scratch and working-memory files: per-activity step trackers and ad-hoc notes.
# These are free-form and never committed.
*-steps.md
*.scratch
scratch/

# Go build output
/bin/

# make test-json output: the raw `go test -json` stream and coverage profile
# tools/testreport and gopogh consume to build the CI test-health report.
/test.json
/coverage.out
/report-*.json
/report-*.html
/coverage-*.html

# tools/testreport badge/render output, built post-merge and pushed to the
# coverage-reports branch -- never committed on this branch.
/coverage-linux.json
/coverage-macos.json
/report.md

# The Windows CNI plugin writes its debug log into the directory it was invoked
# from, which is this one when a container scenario is run from the repository
# root. It records the network interfaces of the machine that ran it.
/wincni.log
