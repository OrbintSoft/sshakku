# Dropped into a private bus's service directory to make org.freedesktop.secrets
# a name that bus knows how to start — what an installed wallet nobody has needed
# yet looks like from the outside.
#
# The command exits at once and never claims the name, so anything that did more
# than look — any call sent to the wallet — would start it, fail, and say so.
[D-BUS Service]
Name=org.freedesktop.secrets
Exec=/bin/true
