# Sway configuration for the KeePassXC test session: the shared headless one,
# plus the single rule this app needs.
include wayland-sway.config

# KeePassXC's main window is where its unlock screen is drawn, so where its
# fields sit depends on how big that window is. Tiled, it would be as big as
# the compositor's output; floating, it keeps the size the app itself asked
# for — which is what an X server with no window manager gives it too.
for_window [app_id="org.keepassxc.KeePassXC"] floating enable
