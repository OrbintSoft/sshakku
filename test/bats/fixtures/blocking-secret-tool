#!/bin/sh
# Stands in for a wallet that is present but locked, whose unlock needs a
# graphical prompt nobody is there to answer: the call simply never returns.
# Copied into a temp directory under the name `secret-tool` by the tests that
# need it, so it is only ever on PATH for those.
#
# The sleep is bounded so a test that fails to bound its own call still ends,
# rather than leaving a process behind for the length of the suite.
sleep 300
